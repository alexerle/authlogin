# Server Configuration
PORT=3001
NODE_ENV=production

# SuperTokens Core Connection
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=

# Domain Configuration
API_DOMAIN=https://auth.10hoch2.de
WEBSITE_DOMAIN=https://auth.10hoch2.de

# Cookie Configuration – MUST be set to avoid "multiple session cookies" errors
COOKIE_DOMAIN=.10hoch2.de

# Cloudflare Turnstile (öffentliche Registrierung)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=auth.10hoch2.de

# Handoff Secret (für Cross-Domain SSO zu cp.zhzcloud.de etc.)
HANDOFF_SECRET=change-me-in-production

# Email (Brevo API preferred, SMTP fallback)
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=noreply@10hoch2.de
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=10hoch2 <noreply@10hoch2.de>

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OIDC Client Secrets
OIDC_OP_SECRET=
OIDC_MATOMO_SECRET=
OIDC_ZAMMAD_SECRET=
OIDC_DOCUMENSO_SECRET=

# Zammad API (für OIDC-Provisioning-Check)
ZAMMAD_API_TOKEN=

# Internal Provisioning
INTERNAL_PROVISION_SECRET=provision-zhz-2026!
